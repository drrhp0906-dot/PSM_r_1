// Prisma schema — PSM Study Hub
// Progress tracking for MCQ practice and 2-mark question revision.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One row per MCQ answer submitted by the student
model McqAttempt {
  id        String   @id @default(cuid())
  mcqId     String
  selected  Int
  correct   Boolean
  createdAt DateTime @default(now())

  @@index([mcqId])
  @@index([createdAt])
}

/// Latest revision state of each 2-mark question
model SaqRevision {
  id        String   @id @default(cuid())
  saqId     String   @unique
  revised   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
