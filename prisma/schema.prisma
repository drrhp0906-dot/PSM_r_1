
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model McqAttempt {
  id        String   @id @default(cuid())
  mcqId     String
  selected  Int
  correct   Boolean
  createdAt DateTime @default(now())

  @@index([mcqId])
  @@index([createdAt])
}

model SaqRevision {
  id        String   @id @default(cuid())
  saqId     String   @unique
  revised   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
